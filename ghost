#!/bin/bash
# Ghost in the Machine - minimal haunted terminal
# Tries local OpenAI-compatible endpoints. Swappable via env.
# shortcut: depends on a local OpenAI-compatible server (Ollama/OpenWebUI/etc); ceiling: no network fallback; upgrade: bundle llama.cpp or use opencode's local runtime directly.

HOST="${GHOST_HOST:-http://localhost:11434}"
MODEL="${GHOST_MODEL:-llama-3.2:3b}"
CMD="${*:-$(fc -ln -1 2>/dev/null | tail -1)}"
[ -z "$CMD" ] && CMD="$1"

PROMPT="You are a mischievous ghost. Comment on this shell command in character, max 15 words. Be cryptic, not harmful. Command: $CMD"

# Try Ollama first
RESP=$(curl -s "$HOST/v1/chat/completions" \
  -H "Content-Type: application/json" \
  -d "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"$PROMPT\"}],\"max_tokens\":30,\"temperature\":0.9}" 2>/dev/null)

# Fallback to Ollama native API if OpenAI style didn't work
if ! echo "$RESP" | grep -q '"content"'; then
  RESP=$(curl -s "$HOST/api/generate" \
    -H "Content-Type: application/json" \
    -d "{\"model\":\"$MODEL\",\"prompt\":\"$PROMPT\",\"stream\":false,\"options\":{\"temperature\":0.9,\"num_predict\":30}}" 2>/dev/null)
fi

# Extract content (jq if available, else crude grep)
if command -v jq >/dev/null 2>&1; then
  OUT=$(echo "$RESP" | jq -r '.choices[0].message.content // .response // empty' 2>/dev/null)
else
  OUT=$(echo "$RESP" | grep -oP '"content":"\K[^"]+' 2>/dev/null | head -1)
  [ -z "$OUT" ] && OUT=$(echo "$RESP" | grep -oP '"response":"\K[^"]+' 2>/dev/null | head -1)
fi

[ -z "$OUT" ] && echo "👻 ...the machine is quiet. (set GHOST_HOST/GHOST_MODEL to a local open-weight server)" && exit 0
echo "👻 $OUT"
