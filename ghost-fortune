#!/bin/bash
# Ghost Fortune - revive fortune-mod with AI possession
# shortcut: no fortune binary installed by default; ceiling: uses embedded corpus as fallback; upgrade: bundle fortune-mod + open fortune dbs.
# shortcut: spooky sound/vocal opt-in only; ceiling: needs audio hardware/tools; upgrade: use pulse/pipewire APIs.

# Config (reuse ghost env vars)
HOST="${GHOST_HOST:-http://localhost:11434}"
MODEL="${GHOST_MODEL:-llama-3.2:3b}"
GHOST_SOUND="${GHOST_SOUND:-0}"
GHOST_VOICE="${GHOST_VOICE:-0}"

# Embedded fallback corpus (tiny, public domain style)
EMBEDDED_FORTUNES=(
"A program that has not been tested does not work."
"The best debugger is still a good night's sleep."
"Beware of bugs in the above code; I have only proved it correct, not tried it."
"Unix is user-friendly. It's just picky about who its friends are."
"Real programmers can write assembly code in any language."
"To err is human, but to really foul things up requires a computer."
"There are only two hard things in Computer Science: cache invalidation, naming things, and off-by-one errors."
"The line between past and present grows thin on nights like this..."
"Some bugs only appear when the moon is full."
"An orphaned process haunts the /proc filesystem still."
)

# Embedded horror stories (terminal/computing lore)
HORROR_STORIES=(
"It was 3 AM when I noticed it. A process with no parent, no TTY, still running after I had logged out decades ago. It has been waiting for me to return ever since."
"The oldest cron job in /etc/cron.d hadn't run in twenty years. Out of morbid curiosity, I checked its last output. It simply read: 'I am still here.'"
"I found a .bash_history file owned by a user that was deleted in 1997. The last command was 'rm -rf ~' followed by fifteen minutes of nothing. I did not run it."
"Forgotten dotfiles whisper in the night. .viminfo remembers every keystroke. .mysql_history remembers every query. Some things were never meant to be recalled."
"An orphaned process haunts /proc. It has no name, only a PID. When I try to kill it, ps shows it has been growing larger with each attempt."
"The fortune daemon has been running since the Reagan administration. Every night at midnight, it writes new fortunes to its database. Nobody knows who feeds it."
"In the deep recesses of /var/log, there exists auth.log entries from users that never existed. They all logged in at exactly 3:33 AM and asked the same question: 'Are you still there?'"
"A sysadmin once told me never to look inside /lost+found at 2 AM. I looked. Now something looks back through every terminal I open."
)

# Colors
RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; BLUE=$'\033[34m'; MAGENTA=$'\033[35m'; CYAN=$'\033[36m'; WHITE=$'\033[37m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'

# Spooky sound effects
play_sound() {
    [ "$GHOST_SOUND" != "1" ] && return 0
    local type="$1"
    if command -v ffmpeg >/dev/null 2>&1 && command -v aplay >/dev/null 2>&1; then
        case "$type" in
            click)
                ffmpeg -f lavfi -i "sine=frequency=800:duration=0.05" -f lavfi -i "anoisesrc=d=0.05:c=pink:r=44100" -filter_complex "[0:a][1:a]amix=inputs=2:duration=shortest" -f wav - 2>/dev/null | aplay -q 2>/dev/null &
                ;;
            summon)
                ffmpeg -f lavfi -i "sine=frequency=200:duration=0.3" -f lavfi -i "anoisesrc=d=0.3:c=brown:r=44100" -filter_complex "[0:a][1:a]amix=inputs=2:duration=shortest,lowpass=f=400" -f wav - 2>/dev/null | aplay -q 2>/dev/null &
                ;;
            reveal)
                ffmpeg -f lavfi -i "sine=frequency=150:duration=0.4" -f lavfi -i "anoisesrc=d=0.4:c=pink:r=44100" -filter_complex "[0:a][1:a]amix=inputs=2:duration=shortest,lowpass=f=600,aphaser" -f wav - 2>/dev/null | aplay -q 2>/dev/null &
                ;;
            quit)
                ffmpeg -f lavfi -i "sine=frequency=100:duration=0.6" -f lavfi -i "anoisesrc=d=0.6:c=brown:r=44100" -filter_complex "[0:a][1:a]amix=inputs=2:duration=shortest,lowpass=f=300,afade=t=out:st=0.3:d=0.3" -f wav - 2>/dev/null | aplay -q 2>/dev/null &
                ;;
        esac
    fi
}

# Spooky vocal/TTS
speak_text() {
    [ "$GHOST_VOICE" != "1" ] && return 0
    local text="$1"
    # strip ANSI codes and box drawing
    text=$(echo "$text" | sed 's/\x1b\[[0-9;]*m//g' | sed 's/[╔╗╚╝║═─]//g' | tr -d '\n' | sed 's/  */ /g')
    # limit length
    [ ${#text} -gt 200 ] && text="${text:0:197}..."
    [ -z "$text" ] && return 0
    if command -v espeak >/dev/null 2>&1; then
        espeak -v en+m3 -p 25 -s 110 "$text" 2>/dev/null &
    elif command -v spd-say >/dev/null 2>&1; then
        spd-say -r -20 -p -20 "$text" 2>/dev/null &
    elif command -v festival >/dev/null 2>&1; then
        echo "$text" | festival --tts 2>/dev/null &
    fi
}

draw_box() {
    local text="$1"
    local width=60
    local padding=2
    local inner=$((width - padding*2))
    printf "${MAGENTA}${BOLD}╔%${width}s╗${RESET}\n" | tr ' ' '═'
    python3 - "$text" "$inner" "$padding" "$width" "$MAGENTA" "$BOLD" "$RESET" << 'PYEOF'
import sys
text = sys.argv[1]
inner = int(sys.argv[2])
padding = int(sys.argv[3])
width = int(sys.argv[4])
MAGENTA = sys.argv[5]
BOLD = sys.argv[6]
RESET = sys.argv[7]
for line in text.splitlines():
    if not line.strip():
        continue
    remaining = line
    while len(remaining) > inner:
        cut = inner
        # find last space
        while cut > 0 and remaining[cut-1] != ' ':
            cut -= 1
        if cut == 0:
            cut = inner
        chunk = remaining[:cut]
        print(f'{MAGENTA}{BOLD}║{RESET}' + ' '*padding + chunk.ljust(inner) + ' '*padding + f'{MAGENTA}{BOLD}║{RESET}')
        remaining = remaining[cut:].lstrip()
    print(f'{MAGENTA}{BOLD}║{RESET}' + ' '*padding + remaining.ljust(inner) + ' '*padding + f'{MAGENTA}{BOLD}║{RESET}')
PYEOF
    printf "${MAGENTA}${BOLD}╚%${width}s╝${RESET}\n" | tr ' ' '═'
}

get_classic_fortune() {
    if command -v fortune >/dev/null 2>&1; then
        fortune 2>/dev/null
        return
    fi
    # fallback to embedded
    local idx=$((RANDOM % ${#EMBEDDED_FORTUNES[@]}))
    echo "${EMBEDDED_FORTUNES[$idx]}"
}

possess_fortune() {
    local base="$1"
    local prompt="You are a mischievous ghost possessing a 1970s UNIX fortune teller. Add 1-2 sentences max, cryptic not harmful, in character of an old fortune. Base fortune: $base"
    
    local resp=$(curl -s "$HOST/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"$PROMPT\"}],\"max_tokens\":40,\"temperature\":0.9}" 2>/dev/null)
    
    if ! echo "$resp" | grep -q '"content"'; then
        resp=$(curl -s "$HOST/api/generate" \
            -H "Content-Type: application/json" \
            -d "{\"model\":\"$MODEL\",\"prompt\":\"$PROMPT\",\"stream\":false,\"options\":{\"temperature\":0.9,\"num_predict\":40}}" 2>/dev/null)
    fi
    
    local out=""
    if command -v jq >/dev/null 2>&1; then
        out=$(echo "$resp" | jq -r '.choices[0].message.content // .response // empty' 2>/dev/null)
    else
        out=$(echo "$resp" | grep -oP '"content":"\K[^"]+' 2>/dev/null | head -1)
        [ -z "$out" ] && out=$(echo "$resp" | grep -oP '"response":"\K[^"]+' 2>/dev/null | head -1)
    fi
    
    if [ -z "$out" ]; then
        echo -e "${DIM}...the machine is quiet. (set GHOST_HOST/GHOST_MODEL)${RESET}"
        echo "$base"
    else
        echo -e "${MAGENTA}👻 $out${RESET}"
        echo
        echo -e "${DIM}---${RESET}"
        echo "$base"
    fi
}

generate_fortune() {
    local prompt="Write a UNIX-style fortune cookie. Max 40 words. Dry, groan-worthy pun or cryptic. No modern slang. Style of 1970s fortune-mod."
    
    local resp=$(curl -s "$HOST/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"$PROMPT\"}],\"max_tokens\":40,\"temperature\":0.95}" 2>/dev/null)
    
    if ! echo "$resp" | grep -q '"content"'; then
        resp=$(curl -s "$HOST/api/generate" \
            -H "Content-Type: application/json" \
            -d "{\"model\":\"$MODEL\",\"prompt\":\"$PROMPT\",\"stream\":false,\"options\":{\"temperature\":0.95,\"num_predict\":40}}" 2>/dev/null)
    fi
    
    local out=""
    if command -v jq >/dev/null 2>&1; then
        out=$(echo "$resp" | jq -r '.choices[0].message.content // .response // empty' 2>/dev/null)
    else
        out=$(echo "$resp" | grep -oP '"content":"\K[^"]+' 2>/dev/null | head -1)
        [ -z "$out" ] && out=$(echo "$resp" | grep -oP '"response":"\K[^"]+' 2>/dev/null | head -1)
    fi
    
    if [ -z "$out" ]; then
        echo -e "${DIM}...the machine is quiet. (set GHOST_HOST/GHOST_MODEL)${RESET}"
        get_classic_fortune
    else
        echo -e "${MAGENTA}👻 $out${RESET}"
    fi
}

tell_tale() {
    local idx=$((RANDOM % ${#HORROR_STORIES[@]}))
    echo -e "${RED}${BOLD}TALE FROM THE MACHINE${RESET}"
    echo
    echo "${HORROR_STORIES[$idx]}"
}

generate_tale() {
    local prompt="Write a short, creepy but family-friendly horror story about forgotten UNIX/terminal computing lore. Max 80 words. Cryptic, eerie, not gory. Style: old sysadmin legend."
    
    local resp=$(curl -s "$HOST/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"$PROMPT\"}],\"max_tokens\":80,\"temperature\":0.9}" 2>/dev/null)
    
    if ! echo "$resp" | grep -q '"content"'; then
        resp=$(curl -s "$HOST/api/generate" \
            -H "Content-Type: application/json" \
            -d "{\"model\":\"$MODEL\",\"prompt\":\"$PROMPT\",\"stream\":false,\"options\":{\"temperature\":0.9,\"num_predict\":80}}" 2>/dev/null)
    fi
    
    local out=""
    if command -v jq >/dev/null 2>&1; then
        out=$(echo "$resp" | jq -r '.choices[0].message.content // .response // empty' 2>/dev/null)
    else
        out=$(echo "$resp" | grep -oP '"content":"\K[^"]+' 2>/dev/null | head -1)
        [ -z "$out" ] && out=$(echo "$resp" | grep -oP '"response":"\K[^"]+' 2>/dev/null | head -1)
    fi
    
    if [ -z "$out" ]; then
        echo -e "${DIM}...the machine is quiet. (set GHOST_HOST/GHOST_MODEL)${RESET}"
        tell_tale
    else
        echo -e "${RED}${BOLD}TALE FROM THE MACHINE${RESET}"
        echo
        echo -e "${MAGENTA}👻 $out${RESET}"
    fi
}

