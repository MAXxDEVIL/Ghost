main_menu() {
    while true; do
        show_header
        echo -e "${BOLD}MENU${RESET}"
        echo -e "  ${GREEN}[1]${RESET} ${BOLD}Classic${RESET}    - Original fortune (untouched)"
        echo -e "  ${MAGENTA}[2]${RESET} ${BOLD}Haunt${RESET}      - Possess a classic fortune with AI whisper"
        echo -e "  ${CYAN}[3]${RESET} ${BOLD}Possess${RESET}    - Generate a new cursed fortune from scratch"
        echo -e "  ${RED}[4]${RESET} ${BOLD}Tales${RESET}      - Tell a haunted tale from forgotten terminals"
        echo -e "  ${RED}[5]${RESET} ${BOLD}Tales (AI)${RESET} - Channel a new tale from beyond"
        echo -e "  ${YELLOW}[q]${RESET} ${BOLD}Quit${RESET}"
        echo
        echo -e -n "${DIM}Model: ${MODEL} @ ${HOST}${RESET} | Choice: "
        read -n 1 choice
        echo
        echo
        
        case "$choice" in
            1)
                play_sound click
                clear
                echo -e "${GREEN}${BOLD}═══ CLASSIC ═══${RESET}\n"
                local_fortune=$(get_classic_fortune)
                draw_box "$local_fortune"
                speak_text "$local_fortune"
                echo -e -n "\n${DIM}Press any key to return...${RESET}"
                read -n 1
                ;;
            2)
                play_sound click
                clear
                echo -e "${MAGENTA}${BOLD}═══ HAUNT ═══${RESET}\n"
                echo -e "${DIM}Summoning from the archive...${RESET}\n"
                play_sound summon
                sleep 0.5
                base_fortune=$(get_classic_fortune)
                result=$(possess_fortune "$base_fortune")
                play_sound reveal
                draw_box "$result"
                speak_text "$result"
                echo -e -n "\n${DIM}Press any key to return...${RESET}"
                read -n 1
                ;;
            3)
                play_sound click
                clear
                echo -e "${CYAN}${BOLD}═══ POSSESS ═══${RESET}\n"
                echo -e "${DIM}Channeling from beyond...${RESET}\n"
                play_sound summon
                sleep 0.5
                result=$(generate_fortune)
                play_sound reveal
                draw_box "$result"
                speak_text "$result"
                echo -e -n "\n${DIM}Press any key to return...${RESET}"
                read -n 1
                ;;
            4)
                play_sound click
                clear
                echo -e "${RED}${BOLD}═══ TALES ═══${RESET}\n"
                echo -e "${DIM}Whispering from forgotten logs...${RESET}\n"
                play_sound summon
                sleep 0.5
                result=$(tell_tale)
                play_sound reveal
                draw_box "$result"
                speak_text "$result"
                echo -e -n "\n${DIM}Press any key to return...${RESET}"
                read -n 1
                ;;
            5)
                play_sound click
                clear
                echo -e "${RED}${BOLD}═══ TALES (AI) ═══${RESET}\n"
                echo -e "${DIM}Channeling from beyond...${RESET}\n"
                play_sound summon
                sleep 0.5
                result=$(generate_tale)
                play_sound reveal
                draw_box "$result"
                speak_text "$result"
                echo -e -n "\n${DIM}Press any key to return...${RESET}"
                read -n 1
                ;;
            q|Q)
                play_sound quit
                clear
                echo -e "${MAGENTA}👻 The spirits return to their slumber...${RESET}"
                sleep 0.3
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid choice${RESET}"
                sleep 1
                ;;
        esac
    done
}

# If called with args, quick mode
if [ $# -gt 0 ]; then
    case "$1" in
        --classic|-c)
            out=$(get_classic_fortune)
            printf "${WHITE}%s${RESET}\n" "$out"
            speak_text "$out"
            exit 0
            ;;
        --haunt|-h)
            play_sound summon
            base=$(get_classic_fortune)
            out=$(possess_fortune "$base")
            play_sound reveal
            printf "%b\n" "$out"
            speak_text "$out"
            exit 0
            ;;
        --possess|-p)
            play_sound summon
            out=$(generate_fortune)
            play_sound reveal
            printf "%b\n" "$out"
            speak_text "$out"
            exit 0
            ;;
        --tale|-t)
            play_sound summon
            out=$(tell_tale)
            play_sound reveal
            printf "%b\n" "$out"
            speak_text "$out"
            exit 0
            ;;
        --tale-ai|--haunt-tale)
            play_sound summon
            out=$(generate_tale)
            play_sound reveal
            printf "%b\n" "$out"
            speak_text "$out"
            exit 0
            ;;
        *)
            echo "Usage: $0 [--classic|--haunt|--possess|--tale|--tale-ai] or run interactively"
            exit 1
            ;;
    esac
fi

main_menu
